{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "test"
  ],
  "properties": {
    "autoMerge": { "type": "boolean", "default": true },
    "autoMergeChecks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "install": {
      "type": "string",
      "minLength": 1
    },
    "test": {
      "type": "string",
      "minLength": 1
    },
    "verify": {
      "type": "string",
      "minLength": 1
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "commands"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "commands": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "securityRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sensitivePaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
