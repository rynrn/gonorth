 <ul>\n    <li>\u05e9\u05d0\u05dc\u05d5 \u05de\u05e8\u05d0\u05e9 \u05e2\u05dc \u05d2\u05d9\u05dc, \u05d2\u05d5\u05d1\u05d4, \u05de\u05e9\u05e7\u05dc, \u05db\u05d5\u05e9\u05e8 \u05d2\u05d5\u05e4\u05e0\u05d9 \u05d5\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d1\u05e8\u05d9\u05d0\u05d5\u05ea\u05d9\u05d5\u05ea \u05e9\u05dc \u05db\u05dc \u05de\u05e9\u05ea\u05ea\u05e3.<\/li>\n    <li>\u05d1\u05e8\u05e8\u05d5 \u05de\u05d4 \u05db\u05dc\u05d5\u05dc \u05d1\u05de\u05d7\u05d9\u05e8: \u05e6\u05d9\u05d5\u05d3, \u05d1\u05d9\u05d8\u05d5\u05d7, \u05d4\u05d3\u05e8\u05db\u05d4, \u05e6\u05d9\u05dc\u05d5\u05dd \u05d5\u05d4\u05e1\u05e2\u05d4 \u05dc\u05e0\u05e7\u05d5\u05d3\u05ea \u05d4\u05d4\u05ea\u05d7\u05dc\u05d4.<\/li>\n    <li>\u05d4\u05d2\u05d9\u05e2\u05d5 \u05de\u05d5\u05e7\u05d3\u05dd \u05dc\u05d4\u05e8\u05e9\u05de\u05d4, \u05dc\u05ea\u05d3\u05e8\u05d9\u05da \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05d5\u05dc\u05d4\u05ea\u05d0\u05de\u05ea \u05e6\u05d9\u05d5\u05d3 \u05d0\u05d9\u05e9\u05d9.<\/li>\n    <li>\u05d4\u05d1\u05d9\u05d0\u05d5 \u05d1\u05d2\u05d3\u05d9\u05dd \u05d5\u05e0\u05e2\u05dc\u05d9\u05d9\u05dd \u05dc\u05e4\u05d9 \u05d4\u05e0\u05d7\u05d9\u05d5\u05ea, \u05d5\u05dc\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05de\u05d9\u05dd \u05d4\u05d1\u05d9\u05d0\u05d5 \u05d2\u05dd \u05d1\u05d2\u05d3\u05d9\u05dd \u05dc\u05d4\u05d7\u05dc\u05e4\u05d4.<\/li>\n  <\/ul>\n\n  <h2>\u05e9\u05d0\u05dc\u05d5\u05ea \u05e0\u05e4\u05d5\u05e6\u05d5\u05ea<\/h2>\n  <h3>\u05d0\u05d9\u05da \u05de\u05ea\u05d0\u05d9\u05de\u05d9\u05dd \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd?<\/h3>\n  <p>\u05d1\u05d5\u05d3\u05e7\u05d9\u05dd \u05d0\u05ea \u05d4\u05d2\u05d9\u05dc \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9, \u05d4\u05de\u05e9\u05da, \u05e8\u05de\u05ea \u05d4\u05de\u05d0\u05de\u05e5, \u05e4\u05d7\u05d3 \u05de\u05d2\u05d1\u05d4\u05d9\u05dd \u05d0\u05d5 \u05de\u05de\u05d9\u05dd \u05d5\u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05e4\u05e8\u05d5\u05e9 \u05d1\u05d0\u05de\u05e6\u05e2. \u05d0\u05d9\u05df \u05dc\u05d4\u05e1\u05ea\u05de\u05da \u05e8\u05e7 \u05e2\u05dc \u05d4\u05d2\u05d3\u05e8\u05d4 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05ea.<\/p>\n  <h3>\u05d4\u05d0\u05dd \u05db\u05dc \u05d4\u05e6\u05d9\u05d5\u05d3 \u05db\u05dc\u05d5\u05dc?<\/h3>\n  <p>\u05d6\u05d4 \u05de\u05e9\u05ea\u05e0\u05d4 \u05de\u05e4\u05e2\u05d9\u05dc \u05dc\u05de\u05e4\u05e2\u05d9\u05dc. \u05d1\u05e8\u05e8\u05d5 \u05d0\u05d9\u05dc\u05d5 \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05de\u05e7\u05d1\u05dc\u05d9\u05dd, \u05d0\u05d9\u05dc\u05d5 \u05de\u05d9\u05d3\u05d5\u05ea \u05d6\u05de\u05d9\u05e0\u05d5\u05ea \u05d5\u05de\u05d4 \u05e6\u05e8\u05d9\u05da \u05dc\u05d4\u05d1\u05d9\u05d0 \u05de\u05d4\u05d1\u05d9\u05ea. \u05d5\u05d3\u05d0\u05d5 \u05e9\u05e6\u05d9\u05d5\u05d3 \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05e0\u05db\u05dc\u05dc.<\/p>\n  <h3>\u05de\u05d4 \u05e7\u05d5\u05e8\u05d4 \u05d0\u05dd \u05de\u05d6\u05d2 \u05d4\u05d0\u05d5\u05d5\u05d9\u05e8 \u05dc\u05d0 \u05de\u05ea\u05d0\u05d9\u05dd?<\/h3>\n  <p>\u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05d4\u05d1\u05d9\u05d8\u05d5\u05dc \u05de\u05e9\u05ea\u05e0\u05d4. \u05dc\u05e4\u05e0\u05d9 \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd \u05d1\u05e8\u05e8\u05d5 \u05de\u05d9 \u05de\u05e7\u05d1\u05dc \u05d0\u05ea \u05d4\u05d4\u05d7\u05dc\u05d8\u05d4, \u05de\u05ea\u05d9 \u05de\u05d5\u05d3\u05d9\u05e2\u05d9\u05dd, \u05d5\u05d4\u05d0\u05dd \u05de\u05e7\u05d1\u05dc\u05d9\u05dd \u05d4\u05d7\u05d6\u05e8, \u05e9\u05d5\u05d1\u05e8 \u05d0\u05d5 \u05de\u05d5\u05e2\u05d3 \u05d7\u05dc\u05d5\u05e4\u05d9.<\/p>\n  <h3>\u05d4\u05d0\u05dd \u05e6\u05e8\u05d9\u05da \u05d1\u05d9\u05d8\u05d5\u05d7 \u05de\u05d9\u05d5\u05d7\u05d3?<\/h3>\n  <p>\u05d9\u05e9 \u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05e9\u05d1\u05d4\u05df \u05d4\u05de\u05e4\u05e2\u05d9\u05dc \u05db\u05d5\u05dc\u05dc \u05db\u05d9\u05e1\u05d5\u05d9, \u05d0\u05da \u05d4\u05d9\u05e7\u05e4\u05d5 \u05d5\u05d4\u05d7\u05e8\u05d9\u05d2\u05d9\u05dd \u05de\u05e9\u05ea\u05e0\u05d9\u05dd. \u05e9\u05d0\u05dc\u05d5 \u05d0\u05ea \u05d4\u05de\u05e4\u05e2\u05d9\u05dc \u05d5\u05d1\u05d3\u05e7\u05d5 \u05d0\u05dd \u05d4\u05e4\u05d5\u05dc\u05d9\u05e1\u05d4 \u05d4\u05d0\u05d9\u05e9\u05d9\u05ea \u05e9\u05dc\u05db\u05dd \u05de\u05db\u05e1\u05d4 \u05d0\u05ea \u05e1\u05d5\u05d2 \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea.<\/p>\n\n  <p><a href=\"https:\/\/gonorth.co.il\/places\/category\/tours\/\">\u05e2\u05d1\u05e8\u05d5 \u05dc\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05e1\u05d9\u05d5\u05e8\u05d9\u05dd \u05d5\u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05d1\u05e6\u05e4\u05d5\u05df \u05d5\u05d1\u05d7\u05e8\u05d5 \u05d0\u05ea \u05d4\u05d7\u05d5\u05d5\u05d9\u05d4 \u05e9\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05dc\u05d4\u05e8\u05db\u05d1 \u05e9\u05dc\u05db\u05dd.<\/a><\/p>\n<\/article>\n","post_title":"\u05d8\u05d9\u05d5\u05d8\u05d4: \u05e1\u05d9\u05d5\u05e8\u05d9\u05dd \u05d1\u05e6\u05e4\u05d5\u05df \u05d5\u05e7\u05d9\u05d0\u05e7\u05d9\u05dd \u05d1\u05e0\u05d7\u05dc \u05d4\u05d9\u05e8\u05d3\u05df","post_excerpt":"","post_status":"draft","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"issue-41-tours-kayaks-review","to_ping":"","pinged":"","post_modified":"2026-09-09 01:55:23","post_modified_gmt":"0000-00-00 00:00:00","post_content_filtered":"","post_parent":0,"guid":"https:\/\/gonorth.co.il\/?page_id=436","menu_order":0,"post_type":"page","post_mime_type":"","comment_count":"0","url":"https:\/\/gonorth.co.il\/?page_id=436"}
