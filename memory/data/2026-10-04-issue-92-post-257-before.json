{"ID":257,"post_author":"0","post_date":"2026-07-21 05:01:31","post_date_gmt":"2026-07-21 05:01:31","post_content":"<div style=\"max-width:720px;margin:0 auto;line-height:1.7;color:#1a1a1a;direction:rtl;text-align:right\"><p style=\"margin:0 0 1.1em\">\u05d0\u05d7\u05ea \u05d4\u05e9\u05d0\u05dc\u05d5\u05ea \u05d4\u05e0\u05e4\u05d5\u05e6\u05d5\u05ea \u05e9\u05dc \u05d4\u05d5\u05e8\u05d9\u05dd \u05e9\u05de\u05ea\u05db\u05e0\u05e0\u05d9\u05dd \u05d8\u05d9\u05d5\u05dc \u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05dc\u05e6\u05e4\u05d5\u05df \u05d4\u05d9\u05d0 \u05e4\u05e9\u05d5\u05d8\u05d4: \u05de\u05d4 \u05e2\u05d5\u05e9\u05d9\u05dd \u05e2\u05dd \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd? \u05d4\u05d2\u05dc\u05d9\u05dc \u05d5\u05d4\u05d2\u05d5\u05dc\u05df \u05de\u05e6\u05d9\u05e2\u05d9\u05dd \u05d4\u05e8\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05de\u05de\u05e1\u05dc\u05d5\u05dc\u05d9 \u05d4\u05dc\u05d9\u05db\u05d4 \u05d5\u05e0\u05d5\u05e3  -  \u05d9\u05e9 \u05db\u05d0\u05df \u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d5\u05ea \u05d9\u05d9\u05e2\u05d5\u05d3\u05d9\u05d5\u05ea \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd, \u05e2\u05dd \u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05de\u05d0\u05d5\u05e8\u05d2\u05e0\u05d5\u05ea, \u05d1\u05e2\u05dc\u05d9 \u05d7\u05d9\u05d9\u05dd, \u05e4\u05d0\u05e8\u05e7\u05d9\u05dd \u05d5\u05de\u05ea\u05d7\u05de\u05d9\u05dd \u05e9\u05de\u05ea\u05d0\u05d9\u05de\u05d9\u05dd \u05dc\u05d2\u05d9\u05dc\u05d0\u05d9\u05dd \u05e9\u05d5\u05e0\u05d9\u05dd. \u05d4\u05d3\u05e3 \u05d4\u05d6\u05d4 \u05de\u05e8\u05db\u05d6 \u05d0\u05e8\u05d1\u05e2 \u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d5\u05ea \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05d5\u05ea \u05e9\u05de\u05d5\u05e4\u05d9\u05e2\u05d5\u05ea \u05d1\u05d0\u05ea\u05e8, \u05e2\u05dd \u05e4\u05e8\u05d8\u05d9\u05dd \u05e2\u05dc \u05d2\u05d9\u05dc \u05de\u05d5\u05de\u05dc\u05e5, \u05e1\u05d5\u05d2\u05d9 \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05d5\u05de\u05d4 \u05db\u05d3\u05d0\u05d9 \u05dc\u05d3\u05e2\u05ea \u05dc\u05e4\u05e0\u05d9 \u05e9\u05de\u05d2\u05d9\u05e2\u05d9\u05dd.<\/p><p style=\"margin:0 0 1.1em\">\u05d4\u05e8\u05e9\u05d9\u05de\u05d4 \u05de\u05ea\u05de\u05e7\u05d3\u05ea \u05d1\u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d5\u05ea \u05e9\u05de\u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc \u05d4\u05d2\u05df \u05d5\u05e2\u05d3 \u05d2\u05d9\u05dc \u05d4\u05d9\u05e1\u05d5\u05d3\u05d9, \u05d0\u05dd \u05db\u05d9 \u05d7\u05dc\u05e7\u05df \u05de\u05e2\u05e0\u05d9\u05d9\u05e0\u05d5\u05ea \u05d2\u05dd \u05dc\u05d2\u05d9\u05dc \u05d4\u05e0\u05d5\u05e2\u05e8. \u05dc\u05e4\u05e0\u05d9 \u05db\u05dc \u05d1\u05d9\u05e7\u05d5\u05e8, \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d1\u05d3\u05d5\u05e7 \u05e9\u05e2\u05d5\u05ea \u05e4\u05ea\u05d9\u05d7\u05d4 \u05d5\u05dc\u05d1\u05d3\u05d5\u05e7 \u05d0\u05dd \u05e0\u05d3\u05e8\u05e9\u05ea \u05d4\u05d6\u05de\u05e0\u05d4 \u05de\u05e8\u05d0\u05e9  -  \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e2\u05d5\u05e0\u05d5\u05ea \u05d4\u05e9\u05d9\u05d0.<\/p>\n<h2 style=\"font-size:1.5em;font-weight:700;margin:1.8em 0 0.5em;line-height:1.3\">\u05db\u05e4\u05e8 \u05d4\u05d7\u05d9\u05d5\u05ea \u2014 \u05de\u05d2\u05e2 \u05e2\u05dd \u05d1\u05e2\u05dc\u05d9 \u05d7\u05d9\u05d9\u05dd \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e7\u05d8\u05e0\u05d9\u05dd<\/h2>\n<p style=\"margin:0 0 1.1em\">\u05db\u05e4\u05e8 \u05d4\u05d7\u05d9\u05d5\u05ea \u05d4\u05d5\u05d0 \u05d0\u05d7\u05ea \u05d4\u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d5\u05ea \u05d4\u05e4\u05d5\u05e4\u05d5\u05dc\u05e8\u05d9\u05d5\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e7\u05d8\u05e0\u05d9\u05dd \u05d1\u05e6\u05e4\u05d5\u05df. \u05d4\u05de\u05e7\u05d5\u05dd \u05de\u05d0\u05e4\u05e9\u05e8 \u05de\u05d2\u05e2 \u05d9\u05e9\u05d9\u05e8 \u05e2\u05dd \u05d1\u05e2\u05dc\u05d9 \u05d7\u05d9\u05d9\u05dd  -  \u05d9\u05dc\u05d3\u05d9\u05dd \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d0\u05db\u05d9\u05dc, \u05dc\u05dc\u05d9\u05d8\u05e3 \u05d5\u05dc\u05d1\u05dc\u05d5\u05ea \u05e2\u05dd \u05d7\u05d9\u05d5\u05ea \u05d7\u05d5\u05d5\u05d4 \u05d5\u05d1\u05e2\u05dc\u05d9 \u05d7\u05d9\u05d9\u05dd \u05de\u05d2\u05d5\u05d5\u05e0\u05d9\u05dd \u05d1\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d1\u05d8\u05d5\u05d7\u05d4 \u05d5\u05de\u05e4\u05d5\u05e7\u05d7\u05ea. \u05d6\u05d4 \u05de\u05ea\u05d0\u05d9\u05dd \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05dc\u05d2\u05d9\u05dc \u05d4\u05e8\u05da, \u05d1\u05e2\u05e8\u05da \u05d2\u05d9\u05dc \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05e2\u05d3 \u05e9\u05de\u05d5\u05e0\u05d4, \u05e9\u05d1\u05d5 \u05d4\u05de\u05e4\u05d2\u05e9 \u05d4\u05d9\u05e9\u05d9\u05e8 \u05e2\u05dd \u05d1\u05e2\u05dc\u05d9 \u05d7\u05d9\u05d9\u05dd \u05d4\u05d5\u05d0 \u05d7\u05d5\u05d5\u05d9\u05d4 \u05de\u05e8\u05d2\u05e9\u05ea \u05d5\u05d1\u05dc\u05ea\u05d9 \u05e0\u05e9\u05db\u05d7\u05ea.<\/p><p style=\"margin:0 0 1.1em\">\u05de\u05d9 \u05e9\u05de\u05d2\u05d9\u05e2 \u05e2\u05dd \u05e4\u05e2\u05d5\u05d8\u05d5\u05ea \u05e9\u05e2\u05d3\u05d9\u05d9\u05df \u05dc\u05d0 \u05d1\u05d2\u05d9\u05dc \u05d1\u05d9\u05ea \u05e1\u05e4\u05e8 \u05d9\u05de\u05e6\u05d0 \u05db\u05d0\u05df \u05d0\u05ea \u05d0\u05d7\u05ea \u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05d4\u05d8\u05d5\u05d1\u05d5\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d0\u05d6\u05d5\u05e8. \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d9\u05d0 \u05d1\u05e2\u05d9\u05e7\u05e8 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea, \u05dc\u05db\u05df \u05db\u05d3\u05d0\u05d9 \u05dc\u05e9\u05d9\u05dd \u05dc\u05d1 \u05dc\u05ea\u05d7\u05d6\u05d9\u05ea \u05de\u05d6\u05d2 \u05d4\u05d0\u05d5\u05d5\u05d9\u05e8. \u05d1\u05ea\u05e7\u05d5\u05e4\u05d5\u05ea \u05e2\u05de\u05d5\u05e1\u05d5\u05ea \u05db\u05de\u05d5 \u05d7\u05d2\u05d9\u05dd \u05d5\u05d7\u05d5\u05e4\u05e9\u05d5\u05ea, \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d1\u05d3\u05d5\u05e7 \u05de\u05e8\u05d0\u05e9 \u05d0\u05dd \u05e0\u05d3\u05e8\u05e9\u05ea \u05d4\u05d6\u05de\u05e0\u05d4.<\/p>\n<h2 style=\"font-size:1.5em;font-weight:700;margin:1.8em 0 0.5em;line-height:1.3\">\u05d2\u05df \u05d2\u05d5\u05e8\u05d5 \u2014 \u05e4\u05d0\u05e8\u05e7 \u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd<\/h2>\n<p style=\"margin:0 0 1.1em\">\u05d2\u05df \u05d2\u05d5\u05e8\u05d5 \u05d4\u05d5\u05d0 \u05de\u05ea\u05d7\u05dd \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05d3\u05d2\u05e9 \u05e2\u05dc \u05d7\u05d5\u05d5\u05d9\u05d4 \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05d5\u05de\u05e9\u05d7\u05e7. \u05d4\u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d4 \u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc \u05d4\u05d2\u05df \u05d5\u05e2\u05d3 \u05d2\u05d9\u05dc \u05d9\u05e1\u05d5\u05d3\u05d9, \u05d5\u05de\u05e6\u05d9\u05e2\u05d4 \u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc \u05de\u05e9\u05d7\u05e7\u05d9\u05dd \u05e4\u05d9\u05d6\u05d9\u05d9\u05dd, \u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05de\u05d0\u05d5\u05e8\u05d2\u05e0\u05d5\u05ea \u05d5\u05e1\u05d1\u05d9\u05d1\u05d4 \u05e9\u05de\u05d0\u05e4\u05e9\u05e8\u05ea \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05d1\u05d6\u05d1\u05d6 \u05d0\u05e0\u05e8\u05d2\u05d9\u05d4 \u05d1\u05e6\u05d5\u05e8\u05d4 \u05de\u05d4\u05e0\u05d4. \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05e0\u05e9\u05d5\u05dd \u05d1\u05e9\u05e7\u05d8 \u05d1\u05d6\u05de\u05df \u05e9\u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05e1\u05d5\u05e7\u05d9\u05dd.<\/p><p style=\"margin:0 0 1.1em\">\u05d6\u05d5 \u05d1\u05d7\u05d9\u05e8\u05d4 \u05d8\u05d5\u05d1\u05d4 \u05dc\u05d9\u05d5\u05dd \u05e9\u05d0\u05d9\u05df \u05d1\u05d5 \u05d7\u05e9\u05e7 \u05dc\u05dc\u05db\u05ea \u05d4\u05e8\u05d7\u05e7 \u05d0\u05d5 \u05db\u05e9\u05de\u05d6\u05d2 \u05d4\u05d0\u05d5\u05d5\u05d9\u05e8 \u05dc\u05d0 \u05de\u05de\u05e9 \u05de\u05d6\u05de\u05d9\u05df \u05dc\u05d8\u05d9\u05d5\u05dc \u05e9\u05d3\u05d4. \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d2\u05e2\u05d4, \u05db\u05d3\u05d0\u05d9 \u05dc\u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05e9\u05e2\u05d5\u05ea \u05d4\u05e4\u05ea\u05d9\u05d7\u05d4 \u05d4\u05e2\u05d3\u05db\u05e0\u05d9\u05d5\u05ea \u05d5\u05d0\u05dd \u05d9\u05e9 \u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05e9\u05d3\u05d5\u05e8\u05e9\u05d5\u05ea \u05d4\u05e8\u05e9\u05de\u05d4 \u05de\u05e8\u05d0\u05e9.<\/p>\n<h2 style=\"font-size:1.5em;font-weight:700;margin:1.8em 0 0.5em;line-height:1.3\">\u05d0\u05d9\u05e0\u05d3\u05d9 \u05e4\u05d0\u05e8\u05e7 \u2014 \u05e4\u05d0\u05e8\u05e7 \u05e9\u05e2\u05e9\u05d5\u05e2\u05d9\u05dd \u05d0\u05e7\u05e1\u05d8\u05e8\u05d9\u05dd \u05dc\u05d2\u05d9\u05dc \u05d4\u05d2\u05d3\u05d5\u05dc \u05d9\u05d5\u05ea\u05e8<\/h2>\n<p style=\"margin:0 0 1.1em\">\u05d0\u05d9\u05e0\u05d3\u05d9 \u05e4\u05d0\u05e8\u05e7 \u05d4\u05d5\u05d0 \u05e4\u05d0\u05e8\u05e7 \u05e9\u05e2\u05e9\u05d5\u05e2\u05d9\u05dd \u05e9\u05de\u05ea\u05d0\u05d9\u05dd \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05d2\u05d3\u05d5\u05dc\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05d5\u05dc\u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8  -  \u05d1\u05e2\u05e8\u05da \u05de\u05d2\u05d9\u05dc \u05e9\u05e9 \u05d5\u05de\u05e2\u05dc\u05d4, \u05ea\u05dc\u05d5\u05d9 \u05d1\u05e1\u05d5\u05d2 \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea. \u05d4\u05e4\u05d0\u05e8\u05e7 \u05de\u05e6\u05d9\u05e2 \u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05db\u05de\u05d5 \u05e7\u05e8\u05d8\u05d9\u05e0\u05d2 \u05d5\u05de\u05e9\u05d7\u05e7\u05d9 \u05d4\u05e8\u05e4\u05ea\u05e7\u05d0\u05d5\u05ea \u05e9\u05de\u05ea\u05d0\u05d9\u05de\u05d9\u05dd \u05dc\u05de\u05d9 \u05e9\u05de\u05d7\u05e4\u05e9 \u05e7\u05e6\u05ea \u05d9\u05d5\u05ea\u05e8 \u05d0\u05d3\u05e8\u05e0\u05dc\u05d9\u05df \u05de\u05d0\u05e9\u05e8 \u05e4\u05d0\u05e8\u05e7 \u05d7\u05d9\u05d5\u05ea \u05d0\u05d5 \u05de\u05d2\u05dc\u05e9\u05d5\u05ea.<\/p><p style=\"margin:0 0 1.1em\">\u05d0\u05d9\u05e0\u05d3\u05d9 \u05e4\u05d0\u05e8\u05e7 \u05d4\u05d5\u05d0 \u05d0\u05d7\u05ea \u05de\u05d4\u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d5\u05ea \u05e9\u05de\u05d5\u05e4\u05d9\u05e2\u05d5\u05ea \u05d1\u05d0\u05ea\u05e8 \u05db\u05d9\u05d5\u05d5\u05df \u05e6\u05e4\u05d5\u05df \u05d5\u05d0\u05e4\u05e9\u05e8 <a href=\"https:\/\/gonorth.co.il\/places\/%d7%90%d7%99%d7%a0%d7%93%d7%99-%d7%a4%d7%90%d7%a8%d7%a7\/\" style=\"color:#0b5fff;text-decoration:underline;text-decoration: underline\">\u05dc\u05e7\u05e8\u05d5\u05d0 \u05e2\u05dc\u05d9\u05d5 \u05e4\u05e8\u05d8\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05d1\u05e2\u05de\u05d5\u05d3 \u05d4\u05de\u05e7\u05d5\u05dd<\/a>. \u05dc\u05de\u05e9\u05e4\u05d7\u05d5\u05ea \u05e2\u05dd \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9\u05dd \u05e9\u05d5\u05e0\u05d9\u05dd  -  \u05d7\u05dc\u05e7 \u05e7\u05d8\u05e0\u05d9\u05dd \u05d5\u05d7\u05dc\u05e7 \u05d2\u05d3\u05d5\u05dc\u05d9\u05dd  -  \u05d0\u05d9\u05e0\u05d3\u05d9 \u05e4\u05d0\u05e8\u05e7 \u05e2\u05d5\u05d1\u05d3 \u05d8\u05d5\u05d1 \u05db\u05e9\u05de\u05e9\u05dc\u05d1\u05d9\u05dd \u05d0\u05d5\u05ea\u05d5 \u05e2\u05dd \u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d4 \u05e0\u05d5\u05e1\u05e4\u05ea \u05e9\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05dc\u05e7\u05d8\u05e0\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8. \u05d4\u05d6\u05de\u05e0\u05d4 \u05de\u05e8\u05d0\u05e9 \u05de\u05d5\u05de\u05dc\u05e6\u05ea, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e1\u05d5\u05e4\u05d9 \u05e9\u05d1\u05d5\u05e2 \u05d5\u05d1\u05d7\u05d2\u05d9\u05dd.<\/p>\n<h2 style=\"font-size:1.5em;font-weight:700;margin:1.8em 0 0.5em;line-height:1.3\">\u05e4\u05d0\u05e8\u05e7 \u05d4\u05de\u05e2\u05d9\u05d9\u05e0\u05d5\u05ea \u2014 \u05d8\u05d1\u05e2 \u05d5\u05de\u05d9\u05dd \u05dc\u05db\u05dc \u05d4\u05d2\u05d9\u05dc<\/h2>\n<p style=\"margin:0 0 1.1em\">\u05e4\u05d0\u05e8\u05e7 \u05d4\u05de\u05e2\u05d9\u05d9\u05e0\u05d5\u05ea \u05d4\u05d5\u05d0 \u05d0\u05d7\u05d3 \u05d4\u05d0\u05ea\u05e8\u05d9\u05dd \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d8\u05d9\u05d5\u05dc \u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05d1\u05d2\u05dc\u05d9\u05dc  -  \u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc \u05d8\u05d1\u05e2, \u05de\u05d9\u05dd \u05d5\u05de\u05e8\u05d7\u05d1 \u05e4\u05ea\u05d5\u05d7. \u05d9\u05dc\u05d3\u05d9\u05dd \u05d0\u05d5\u05d4\u05d1\u05d9\u05dd \u05d0\u05ea \u05d4\u05e7\u05e8\u05d1\u05d4 \u05dc\u05e0\u05d7\u05dc \u05d5\u05dc\u05de\u05d9\u05dd, \u05d5\u05d4\u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05e7\u05e6\u05e8\u05d9\u05dd \u05d5\u05e0\u05d2\u05d9\u05e9\u05d9\u05dd \u05de\u05e1\u05e4\u05d9\u05e7 \u05d1\u05e9\u05d1\u05d9\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd \u05e9\u05e2\u05d5\u05d3 \u05dc\u05d0 \u05d1\u05e9\u05dc\u05d9\u05dd \u05dc\u05d8\u05d9\u05d5\u05dc\u05d9 \u05e9\u05d3\u05d4 \u05d0\u05e8\u05d5\u05db\u05d9\u05dd. \u05d6\u05d5 \u05d2\u05dd \u05d0\u05d7\u05ea \u05d4\u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d5\u05ea \u05e9\u05dc\u05d0 \u05d3\u05d5\u05e8\u05e9\u05d5\u05ea \u05d4\u05d6\u05de\u05e0\u05d4 \u05de\u05e8\u05d0\u05e9 \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc.<\/p><p style=\"margin:0 0 1.1em\">\u05d4\u05e4\u05d0\u05e8\u05e7 \u05de\u05ea\u05d0\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d0\u05d1\u05d9\u05d1 \u05d5\u05dc\u05e1\u05ea\u05d9\u05d5, \u05db\u05e9\u05d4\u05d8\u05de\u05e4\u05e8\u05d8\u05d5\u05e8\u05d5\u05ea \u05e0\u05d5\u05d7\u05d5\u05ea \u05d5\u05d4\u05de\u05d9\u05dd \u05d6\u05d5\u05e8\u05de\u05d9\u05dd. \u05d1\u05e7\u05d9\u05e5 \u05d6\u05d4 \u05e2\u05d3\u05d9\u05d9\u05df \u05db\u05d9\u05e3, \u05d0\u05d1\u05dc \u05db\u05d3\u05d0\u05d9 \u05dc\u05d4\u05d2\u05d9\u05e2 \u05de\u05d5\u05e7\u05d3\u05dd \u05db\u05d3\u05d9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05d4\u05d7\u05d5\u05dd \u05d1\u05e9\u05e2\u05d5\u05ea \u05d4\u05e6\u05d4\u05e8\u05d9\u05d9\u05dd. \u05d1\u05d9\u05d2\u05d5\u05d3 \u05e9\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05e8\u05d8\u05d9\u05d1 \u05d4\u05d5\u05d0 \u05d1\u05d7\u05d9\u05e8\u05d4 \u05d7\u05db\u05de\u05d4  -  \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d8\u05d5\u05d7 \u05d9\u05db\u05e0\u05d9\u05e1\u05d5 \u05d0\u05ea \u05d4\u05e8\u05d2\u05dc\u05d9\u05d9\u05dd \u05dc\u05de\u05d9\u05dd.<\/p>\n<h2 style=\"font-size:1.5em;font-weight:700;margin:1.8em 0 0.5em;line-height:1.3\">\u05d8\u05d9\u05e4\u05d9\u05dd \u05dc\u05ea\u05db\u05e0\u05d5\u05df \u05d9\u05d5\u05dd \u05db\u05d9\u05e3 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05d1\u05e6\u05e4\u05d5\u05df<\/h2>\n<p style=\"margin:0 0 1.1em\">\u05db\u05de\u05d4 \u05d3\u05d1\u05e8\u05d9\u05dd \u05e9\u05db\u05d3\u05d0\u05d9 \u05dc\u05d3\u05e2\u05ea \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d9\u05d5\u05e6\u05d0\u05d9\u05dd \u05dc\u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d5\u05ea \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05e6\u05e4\u05d5\u05df:<\/p><ul style=\"margin:0 0 1.1em;padding-right:1.4em\"><li style=\"margin:0 0 0.4em\"><strong>\u05d1\u05d3\u05e7\u05d5 \u05e9\u05e2\u05d5\u05ea \u05e4\u05ea\u05d9\u05d7\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d9\u05e6\u05d9\u05d0\u05d4.<\/strong> \u05d7\u05dc\u05e7 \u05de\u05d4\u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d5\u05ea \u05e1\u05d2\u05d5\u05e8\u05d5\u05ea \u05d1\u05d9\u05de\u05d9 \u05e9\u05e0\u05d9 \u05d0\u05d5 \u05e9\u05dc\u05d9\u05e9\u05d9, \u05d5\u05e9\u05e2\u05d5\u05ea \u05d4\u05e4\u05ea\u05d9\u05d7\u05d4 \u05de\u05e9\u05ea\u05e0\u05d5\u05ea \u05dc\u05e4\u05d9 \u05e2\u05d5\u05e0\u05d4.<\/li><li style=\"margin:0 0 0.4em\"><strong>\u05d4\u05d6\u05de\u05e0\u05d4 \u05de\u05e8\u05d0\u05e9.<\/strong> \u05d1\u05d7\u05d2\u05d9\u05dd \u05d5\u05d1\u05d7\u05d5\u05e4\u05e9\u05d5\u05ea \u05d1\u05d9\u05ea \u05e1\u05e4\u05e8, \u05db\u05de\u05d4 \u05de\u05d4\u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d5\u05ea \u05e2\u05de\u05d5\u05e1\u05d5\u05ea \u05de\u05d0\u05d5\u05d3. \u05e2\u05d3\u05d9\u05e3 \u05dc\u05d1\u05d3\u05d5\u05e7 \u05d0\u05dd \u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05d6\u05de\u05d9\u05df \u05de\u05e8\u05d0\u05e9 \u05d5\u05dc\u05d7\u05e1\u05d5\u05da \u05d4\u05de\u05ea\u05e0\u05d4.<\/li><li style=\"margin:0 0 0.4em\"><strong>\u05d2\u05d9\u05dc \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05e7\u05d5\u05d1\u05e2.<\/strong> \u05dc\u05d0 \u05db\u05dc \u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d4 \u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05dc\u05db\u05dc \u05d2\u05d9\u05dc. \u05db\u05e4\u05e8 \u05d4\u05d7\u05d9\u05d5\u05ea \u05d5\u05d2\u05df \u05d2\u05d5\u05e8\u05d5 \u05de\u05d5\u05ea\u05d0\u05de\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d2\u05d9\u05dc \u05d4\u05e8\u05da, \u05d5\u05d0\u05d9\u05e0\u05d3\u05d9 \u05e4\u05d0\u05e8\u05e7 \u05de\u05ea\u05d0\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d2\u05d3\u05d5\u05dc\u05d9\u05dd.<\/li><li style=\"margin:0 0 0.4em\"><strong>\u05e9\u05dc\u05d1\u05d5 \u05e2\u05dd \u05d8\u05d9\u05d5\u05dc \u05d8\u05d1\u05e2.<\/strong> \u05e4\u05d0\u05e8\u05e7 \u05d4\u05de\u05e2\u05d9\u05d9\u05e0\u05d5\u05ea \u05d0\u05e4\u05e9\u05e8 \u05dc\u05e9\u05dc\u05d1 \u05e2\u05dd \u05de\u05e1\u05dc\u05d5\u05dc \u05e7\u05e6\u05e8 \u05d1\u05e1\u05d1\u05d9\u05d1\u05d4  -  \u05db\u05da \u05de\u05e7\u05d1\u05dc\u05d9\u05dd \u05d9\u05d5\u05dd \u05e9\u05dc\u05dd \u05e2\u05dd \u05d2\u05d9\u05d5\u05d5\u05df. \u05d0\u05e4\u05e9\u05e8 \u05dc\u05d7\u05e4\u05e9 \u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05d1<a href=\"https:\/\/gonorth.co.il\/places\/category\/teva\/\" style=\"color:#0b5fff;text-decoration:underline;text-decoration: underline\">\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05d8\u05d1\u05e2 \u05d5\u05d4\u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd<\/a> \u05d1\u05d0\u05ea\u05e8.<\/li><li style=\"margin:0 0 0.4em\"><strong>\u05d0\u05d5\u05db\u05dc \u05d5\u05dc\u05d9\u05e0\u05d4.<\/strong> \u05d0\u05dd \u05de\u05ea\u05db\u05e0\u05e0\u05d9\u05dd \u05dc\u05d9\u05e0\u05d4, \u05d9\u05e9 \u05d4\u05de\u05d5\u05df \u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05d1\u05e6\u05e4\u05d5\u05df. \u05ea\u05d5\u05db\u05dc\u05d5 \u05dc\u05e7\u05e8\u05d5\u05d0 \u05e2\u05dc <a href=\"https:\/\/gonorth.co.il\/%d7%9c%d7%99%d7%a0%d7%94-%d7%91%d7%a6%d7%a4%d7%95%d7%9f-%d7%99%d7%a9%d7%a8%d7%90%d7%9c-