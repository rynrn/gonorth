05ea.<\/li>\n<li>\u05e9\u05d9\u05e8\u05d5\u05ea\u05d9 \u05de\u05e4\u05d5\u05ea \u05d5\u05de\u05d3\u05e8\u05d9\u05db\u05d9\u05dd \u05de\u05d5\u05db\u05e8\u05d9\u05dd \u05dc\u05e6\u05d5\u05e8\u05da \u05d4\u05e6\u05dc\u05d1\u05d4, \u05db\u05d0\u05e9\u05e8 \u05d0\u05d9\u05df \u05de\u05e7\u05d5\u05e8 \u05d9\u05e9\u05d9\u05e8 \u05de\u05e1\u05e4\u05d9\u05e7.<\/li>\n<\/ol>\n<p>\u05d0\u05e0\u05d7\u05e0\u05d5 \u05d1\u05d5\u05d3\u05e7\u05d9\u05dd \u05d1\u05e0\u05e4\u05e8\u05d3 \u05db\u05ea\u05d5\u05d1\u05ea, \u05d8\u05dc\u05e4\u05d5\u05df, \u05d0\u05ea\u05e8, \u05e9\u05e2\u05d5\u05ea \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea, \u05de\u05d7\u05d9\u05e8 \u05d5\u05de\u05e6\u05d1 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea. \u05ea\u05d0\u05e8\u05d9\u05da \u05d1\u05d3\u05d9\u05e7\u05d4 \u05de\u05d5\u05e6\u05d2 \u05e8\u05e7 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d1\u05d5\u05e6\u05e2\u05d4 \u05d1\u05d3\u05d9\u05e7\u05d4 \u05d1\u05e4\u05d5\u05e2\u05dc. \u05d0\u05dd \u05e4\u05e8\u05d8 \u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d9\u05de\u05d5\u05ea, \u05d0\u05e0\u05d7\u05e0\u05d5 \u05de\u05e2\u05d3\u05d9\u05e4\u05d9\u05dd \u05dc\u05d4\u05e9\u05d0\u05d9\u05e8 \u05d0\u05d5\u05ea\u05d5 \u05d7\u05e1\u05e8 \u05d5\u05dc\u05db\u05d5\u05d5\u05df \u05d0\u05ea \u05d4\u05e7\u05d5\u05e8\u05d0\u05d9\u05dd \u05dc\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d4\u05d2\u05e2\u05d4.<\/p>\n<p>\u05e9\u05e2\u05d5\u05ea, \u05de\u05d7\u05d9\u05e8\u05d9\u05dd, \u05ea\u05e0\u05d0\u05d9 \u05db\u05e0\u05d9\u05e1\u05d4 \u05d5\u05de\u05e6\u05d1 \u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05e9\u05ea\u05e0\u05d5\u05ea \u05d1\u05d2\u05dc\u05dc \u05e2\u05d5\u05e0\u05d4, \u05d7\u05d2\u05d9\u05dd, \u05de\u05d6\u05d2 \u05d0\u05d5\u05d5\u05d9\u05e8 \u05d0\u05d5 \u05de\u05e6\u05d1 \u05d1\u05d9\u05d8\u05d7\u05d5\u05e0\u05d9. \u05dc\u05db\u05df \u05d2\u05dd \u05de\u05d9\u05d3\u05e2 \u05e9\u05e0\u05d1\u05d3\u05e7 \u05d0\u05d9\u05e0\u05d5 \u05ea\u05d7\u05dc\u05d9\u05e3 \u05dc\u05d0\u05d9\u05de\u05d5\u05ea \u05de\u05d5\u05dc \u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05de\u05e4\u05e2\u05d9\u05dc \u05e1\u05de\u05d5\u05da \u05dc\u05d9\u05e6\u05d9\u05d0\u05d4.<\/p>\n\n<h2>\u05e2\u05e1\u05e7\u05d9\u05dd \u05e9\u05e0\u05e1\u05d2\u05e8\u05d5 \u05d5\u05de\u05d9\u05d3\u05e2 \u05e9\u05d4\u05ea\u05d9\u05d9\u05e9\u05df<\/h2>\n<p>\u05db\u05d0\u05e9\u05e8 \u05d9\u05e9 \u05e8\u05d0\u05d9\u05d4 \u05d0\u05de\u05d9\u05e0\u05d4 \u05e9\u05e2\u05e1\u05e7 \u05e0\u05e1\u05d2\u05e8, \u05d0\u05d9\u05e0\u05e0\u05d5 \u05de\u05d5\u05d7\u05e7\u05d9\u05dd \u05d0\u05ea \u05d4\u05d3\u05e3 \u05d1\u05d0\u05d5\u05e4\u05df \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9. \u05d0\u05e0\u05d7\u05e0\u05d5 \u05de\u05e1\u05de\u05e0\u05d9\u05dd \u05e9\u05d4\u05de\u05e7\u05d5\u05dd \u05d0\u05d9\u05e0\u05d5 \u05d6\u05de\u05d9\u05df, \u05de\u05e1\u05d9\u05e8\u05d9\u05dd \u05e4\u05e8\u05d8\u05d9 \u05e7\u05e9\u05e8 \u05d0\u05d5 \u05e0\u05d9\u05d5\u05d5\u05d8 \u05e9\u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d8\u05e2\u05d5\u05ea, \u05d5\u05de\u05e9\u05d0\u05d9\u05e8\u05d9\u05dd \u05d0\u05ea \u05d4\u05db\u05ea\u05d5\u05d1\u05ea \u05d4\u05e7\u05d1\u05d5\u05e2\u05d4 \u05db\u05d0\u05e9\u05e8 \u05d9\u05e9 \u05dc\u05d4 \u05e2\u05e8\u05da \u05dc\u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05d5\u05dc\u05de\u05e0\u05d5\u05e2\u05d9 \u05d7\u05d9\u05e4\u05d5\u05e9. \u05d1\u05de\u05d9\u05d3\u05ea \u05d4\u05d0\u05e4\u05e9\u05e8 \u05e0\u05d5\u05e1\u05d9\u05e3 \u05d7\u05dc\u05d5\u05e4\u05d5\u05ea \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d5\u05ea \u05d1\u05d0\u05d6\u05d5\u05e8.<\/p>\n\n<h2>\u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05ea\u05d9\u05e7\u05d5\u05e0\u05d9\u05dd \u05d5\u05e2\u05d3\u05db\u05d5\u05e0\u05d9\u05dd<\/h2>\n<p>\u05de\u05e6\u05d0\u05ea\u05dd \u05d8\u05e2\u05d5\u05ea, \u05e4\u05e8\u05d8 \u05e9\u05d4\u05ea\u05d9\u05d9\u05e9\u05df \u05d0\u05d5 \u05de\u05e7\u05d5\u05dd \u05e9\u05e9\u05d9\u05e0\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea? \u05e9\u05dc\u05d7\u05d5 \u05dc\u05e0\u05d5 \u05d0\u05ea \u05e9\u05dd \u05d4\u05e2\u05de\u05d5\u05d3, \u05d4\u05e4\u05e8\u05d8 \u05e9\u05d3\u05d5\u05e8\u05e9 \u05ea\u05d9\u05e7\u05d5\u05df \u05d5\u05de\u05e7\u05d5\u05e8 \u05ea\u05d5\u05de\u05da \u05d3\u05e8\u05da <a href=\"https:\/\/gonorth.co.il\/contact\/\">\u05d3\u05e3 \u05d9\u05e6\u05d9\u05e8\u05ea \u05d4\u05e7\u05e9\u05e8<\/a>. \u05e6\u05d5\u05d5\u05ea \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d1\u05d5\u05d3\u05e7 \u05d0\u05ea \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7 \u05de\u05d5\u05dc \u05de\u05e7\u05d5\u05e8 \u05de\u05ea\u05d0\u05d9\u05dd, \u05de\u05e2\u05d3\u05db\u05df \u05db\u05d0\u05e9\u05e8 \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05de\u05ea \u05d0\u05ea \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9, \u05d5\u05e9\u05d5\u05de\u05e8 \u05de\u05d9\u05d3\u05e2 \u05dc\u05d0 \u05d5\u05d3\u05d0\u05d9 \u05de\u05d7\u05d5\u05e5 \u05dc\u05e9\u05d3\u05d5\u05ea \u05d4\u05e2\u05d5\u05d1\u05d3\u05ea\u05d9\u05d9\u05dd.<\/p>\n<p>\u05ea\u05d9\u05e7\u05d5\u05df \u05de\u05d4\u05d5\u05ea\u05d9 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05e1\u05ea\u05e8 \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05de\u05d7\u05d9\u05e7\u05ea \u05e2\u05de\u05d5\u05d3. \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc \u05e9\u05d9\u05e0\u05d5\u05d9 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea, \u05e1\u05d2\u05d9\u05e8\u05d4 \u05d0\u05d5 \u05d4\u05d7\u05dc\u05e4\u05ea \u05d1\u05e2\u05dc\u05d5\u05ea \u05d0\u05e0\u05d7\u05e0\u05d5 \u05de\u05e2\u05d3\u05db\u05e0\u05d9\u05dd \u05d0\u05ea \u05de\u05e6\u05d1 \u05d4\u05e2\u05de\u05d5\u05d3 \u05d5\u05de\u05d5\u05e0\u05e2\u05d9\u05dd \u05d4\u05e6\u05d2\u05d4 \u05e9\u05dc \u05e4\u05e8\u05d8\u05d9\u05dd \u05d9\u05e9\u05e0\u05d9\u05dd \u05db\u05de\u05d9\u05d3\u05e2 \u05e4\u05e2\u05d9\u05dc.<\/p>\n\n<h2>\u05d2\u05d9\u05dc\u05d5\u05d9 \u05e0\u05d0\u05d5\u05ea \u05d5\u05ea\u05d5\u05db\u05df \u05de\u05e1\u05d7\u05e8\u05d9<\/h2>\n<p>\u05e0\u05db\u05d5\u05df \u05dc\u05de\u05d5\u05e2\u05d3 \u05d4\u05e2\u05d3\u05db\u05d5\u05df, \u05d4\u05de\u05dc\u05e6\u05d5\u05ea \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d0\u05d9\u05e0\u05df \u05e0\u05e7\u05d1\u05e2\u05d5\u05ea \u05d1\u05ea\u05e9\u05dc\u05d5\u05dd. \u05d0\u05dd \u05e0\u05e4\u05e8\u05e1\u05dd \u05d1\u05e2\u05ea\u05d9\u05d3 \u05ea\u05d5\u05db\u05df \u05de\u05de\u05d5\u05de\u05df, \u05de\u05d9\u05e7\u05d5\u05dd \u05d1\u05ea\u05e9\u05dc\u05d5\u05dd \u05d0\u05d5 \u05e7\u05d9\u05e9\u05d5\u05e8 \u05e9\u05d5\u05ea\u05e4\u05d9\u05dd \u05e9\u05de\u05de\u05e0\u05d5 \u05d4\u05d0\u05ea\u05e8 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05e7\u05d1\u05dc \u05e2\u05de\u05dc\u05d4, \u05e0\u05e1\u05de\u05df \u05d6\u05d0\u05ea \u05d1\u05d0\u05d5\u05e4\u05df \u05d1\u05e8\u05d5\u05e8 \u05e1\u05de\u05d5\u05da \u05dc\u05ea\u05d5\u05db\u05df \u05d0\u05d5 \u05dc\u05e7\u05d9\u05e9\u05d5\u05e8. \u05d4\u05ea\u05e7\u05e9\u05e8\u05d5\u05ea \u05de\u05e1\u05d7\u05e8\u05d9\u05ea \u05d0\u05d9\u05e0\u05d4 \u05de\u05e7\u05e0\u05d4 \u05d6\u05db\u05d5\u05ea \u05dc\u05e9\u05e0\u05d5\u05ea \u05e2\u05d5\u05d1\u05d3\u05d5\u05ea, \u05dc\u05d4\u05e1\u05ea\u05d9\u05e8 \u05e1\u05d2\u05d9\u05e8\u05d4 \u05d0\u05d5 \u05dc\u05e2\u05e7\u05d5\u05e3 \u05d0\u05ea \u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4.<\/p>\n\n<h2>\u05e4\u05e0\u05d9\u05d9\u05d4 \u05dc\u05de\u05e2\u05e8\u05db\u05ea<\/h2>\n<p>\u05d0\u05e4\u05e9\u05e8 \u05dc\u05e4\u05e0\u05d5\u05ea \u05d0\u05dc\u05d9\u05e0\u05d5 \u05d1\u05e9\u05d0\u05dc\u05d5\u05ea, \u05d1\u05d4\u05e6\u05e2\u05d5\u05ea \u05d5\u05d1\u05d3\u05d9\u05d5\u05d5\u05d7\u05d9\u05dd \u05d3\u05e8\u05da <a href=\"https:\/\/gonorth.co.il\/contact\/\">\u05e6\u05d5\u05e8 \u05e7\u05e9\u05e8<\/a>. \u05d1\u05e2\u05dc\u05d9 \u05de\u05e7\u05d5\u05de\u05d5\u05ea \u05de\u05d5\u05d6\u05de\u05e0\u05d9\u05dd \u05dc\u05e6\u05e8\u05e3 \u05e7\u05d9\u05e9\u05d5\u05e8 \u05e8\u05e9\u05de\u05d9 \u05d0\u05d5 \u05de\u05e1\u05de\u05da \u05e2\u05d3\u05db\u05e0\u05d9 \u05e9\u05d9\u05e2\u05d6\u05d5\u05e8 \u05dc\u05e0\u05d5 \u05dc\u05d0\u05de\u05ea \u05d0\u05ea \u05d4\u05e4\u05e8\u05d8\u05d9\u05dd.<\/p>\n\n<p><strong>\u05e2\u05d5\u05d3\u05db\u05df \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4:<\/strong> 26 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2026<\/p>","post_title":"\u05d0\u05d5\u05d3\u05d5\u05ea \u05db\u05d9\u05d5\u05d5\u05df \u05e6\u05e4\u05d5\u05df - \u05de\u05d3\u05e8\u05d9\u05da \u05dc\u05d8\u05d9\u05d5\u05dc \u05d1\u05e6\u05e4\u05d5\u05df \u05d9\u05e9\u05e8\u05d0\u05dc","post_excerpt":"\u05d4\u05db\u05d9\u05e8\u05d5 \u05d0\u05ea \u05de\u05e2\u05e8\u05db\u05ea \u05db\u05d9\u05d5\u05d5\u05df \u05e6\u05e4\u05d5\u05df, \u05e9\u05d9\u05d8\u05ea \u05d0\u05d9\u05de\u05d5\u05ea \u05d4\u05de\u05d9\u05d3\u05e2, \u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05d4\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d5\u05d4\u05ea\u05d9\u05e7\u05d5\u05e0\u05d9\u05dd \u05d5\u05d4\u05d2\u05d9\u05dc\u05d5\u05d9 \u05d4\u05e0\u05d0\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d3\u05e8\u05d9\u05da \u05dc\u05e6\u05e4\u05d5\u05df \u05d9\u05e9\u05e8\u05d0\u05dc.","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"about","to_ping":"","pinged":"","post_modified":"2026-10-06 00:31:31","post_modified_gmt":"2026-10-06 00:31:31","post_content_filtered":"","post_parent":0,"guid":"https:\/\/gonorth.co.il\/about\/","menu_order":0,"post_type":"page","post_mime_type":"","comment_count":"0","url":"https:\/\/gonorth.co.il\/about\/"}
